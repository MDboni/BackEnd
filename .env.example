# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=5000

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/messmate?schema=public"

# Comma-separated list of exact allowed browser origins (CORS)
FRONTEND_URL=http://localhost:3000

BCRYPT_SALT_ROUNDS=12

# Must be at least 16 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Only set in production when the API and frontend share a parent domain
# COOKIE_DOMAIN=.example.com

LOG_LEVEL=info
