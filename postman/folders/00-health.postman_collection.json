  "item": [
    {
      "name": "Live check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health/live",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health",
            "live"
          ]
        },
        "description": "**Ki kore:** Node process cholche kina bole.\n\n**Kokhon lagbe:** Server on ache kina jante. Database down thakleo eta 200 debe.\n\n**Expect:** `200` + `{ status: \"ok\", uptime: <seconds> }`",
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Ready check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health/ready",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health",
            "ready"
          ]
        },
        "description": "**Ki kore:** Database-e `SELECT 1` chaliye dekhe connection ache kina.\n\n**Kokhon lagbe:** Deploy-er por, ba kono request-e 500 pele — problem ta app-e naki DB-te seta alada kore.\n\n**Expect:** `200` + `{ status: \"ready\", database: \"connected\" }`. DB down hole `503`.",
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"DB connected\", () => pm.expect(pm.response.json().database).to.eql(\"connected\"));"
            ]
          }
        }
      ]
    },
