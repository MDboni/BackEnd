  "item": [
    {
      "name": "Create mess",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/messes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "messes"
          ]
        },
        "description": "**Ki kore:** Notun mess banay ar tomake OWNER banay — duitai ek transaction-e, tai owner chhara mess kokhono toiri hoy na.\n\n**Field gulo:**\n- `timezone` — cutoff ei timezone-e hisheb hoy (server-er ghori na)\n- `mealCutoffTime` — ei somoy-er por member ajker meal bodlate parbe na\n- `cutoffDaysAhead` — koto din samner meal set kora jabe (1 = shudhu kal)\n\n**Expect:** `201` + mess object with auto-generated `slug`.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Mess\",\n  \"address\": \"House 9, Road 3, Mirpur, Dhaka\",\n  \"timezone\": \"Asia/Dhaka\",\n  \"mealCutoffTime\": \"22:00\",\n  \"cutoffDaysAhead\": 1,\n  \"roundingScale\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"newMessId\", pm.response.json().data.id);",
              "try { pm.environment.set(\"newMessId\", pm.response.json().data.id); } catch (e) { /* no environment selected */ }"
            ]
          }
        }
      ]
    },
    {
      "name": "My messes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/messes/my",
          "host": [
            "{{baseUrl}}"
          ],
