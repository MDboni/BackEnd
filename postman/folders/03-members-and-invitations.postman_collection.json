            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Change member status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/messes/{{messId}}/members/{{targetMembershipId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "messes",
            "{{messId}}",
            "members",
            "{{targetMembershipId}}",
            "status"
          ]
        },
        "description": "**Ki kore:** Member ke ACTIVE / INACTIVE / REMOVED kore.\n\n**Parthokko:**\n- `INACTIVE` — mess-e ache kintu notun meal/expense likhte parbe na; purono hisheb thake\n- `REMOVED` — puropuri baad\n\n**Guard:** kono OPEN month-e oi member-er meal entry thakle `REMOVED` block hoy (`422`) — karon tahole hisheb-er ekta angsho malikbihin hoye jay. Message-e bole INACTIVE koro ba age month close koro.\n\n**Expect:** `200`",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"INACTIVE\",\n  \"reason\": \"Went home for two months\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
