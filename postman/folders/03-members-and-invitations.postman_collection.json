    },
    {
      "name": "Switch to the test account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "description": "**Ki kore:** \"01 · Auth → Register\"-e bana notun account-e login kore, jate join flow ta sotti kore test kora jay.\n\nOwner already member, tai owner diye join chesta korle shudhu `409` ashto.\n\n**⚠️ Age \"01 · Auth → Register\" chalate hobe** — na hole `joinEmail` khali thakbe.\n\n**Expect:** `200`",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{joinEmail}}\",\n  \"password\": \"Messmate123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"accessToken\", pm.response.json().data.accessToken);\ntry { pm.environment.set(\"accessToken\", pm.response.json().data.accessToken); } catch (e) { /* no environment selected */ }"
            ]
