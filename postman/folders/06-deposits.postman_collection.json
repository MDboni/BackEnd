  "item": [
    {
      "name": "Create deposit  ⭐",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/messes/{{messId}}/deposits",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "messes",
            "{{messId}}",
            "deposits"
          ]
        },
        "description": "**Ki kore:** Kono member-er joma record kore.\n\n`reference` — bKash/Nagad trx id rakhar jonno, pore mile dekhte kaje lage.\n\n**Kon month-e jabe:** `transactionDate` dekhe automatic thik hoy. Oi month closed thakle `409`.\n\n**Ke parbe:** ACCOUNTANT+. Member nije nijer deposit likhte pare na — nahole je keu bolte parto \"ami 5000 diyechi\".\n\n**Expect:** `201`",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"membershipId\": \"{{membershipId}}\",\n  \"type\": \"DEPOSIT\",\n  \"amount\": \"5000.00\",\n  \"transactionDate\": \"{{today}}\",\n  \"reference\": \"bKash TrxID 9F3K2L\",\n  \"note\": \"Maser prothom joma\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"depositId\", pm.response.json().data.id);\ntry { pm.environment.set(\"depositId\", pm.response.json().data.id); } catch (e) { /* no environment selected */ }"
            ]
          }
        }
      ]
    },
    {
      "name": "Create refund",
